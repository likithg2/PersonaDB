<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>edit username</title>
</head>
<body>
    <h3>You r gonna edit the username of <h2><%=data.email%></h2></h3>
    <form action="/user/<%=data.id%>?__method=PATCH" method="post">
        <textarea name="username"><%=data.username%></textarea>
        <input type="password" name="password" placeholder="password">
        <button>Submit</button>
    </form>
</body>
</html>